# Template for a new client's Microsoft Graph credentials.
#
# Copy this to secrets/<client-slug>.env (e.g. secrets/acme.env) and fill in the
# values from the client's Azure app registration Overview + Certificates&secrets.
# The secrets/ directory is gitignored; this .example file is the only thing that
# may be committed (it contains no real values).
#
#   MS_TENANT_ID  = Directory (tenant) ID         — app Overview page
#   MS_APP_ID     = Application (client) ID        — app Overview page (NOT Object ID)
#   MS_APP_SECRET = client secret VALUE            — Certificates & secrets (NOT the secret ID)

MS_TENANT_ID=
MS_APP_ID=
MS_APP_SECRET=
